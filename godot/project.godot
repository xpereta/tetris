[debug]

; The GDScript port mirrors dynamically-typed JS (pieces are Dictionaries,
; board cells are null/strings). INFERENCE_ON_VARIANT defaults to Error in
; Godot 4 and would reject the faithful port; demote it to Ignore.
gdscript/warnings/treat_warnings_as_errors=false
gdscript/warnings/inference_on_variant=0